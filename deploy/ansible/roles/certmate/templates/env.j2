# Managed by Ansible (fabriziosalmi.certmate role). Local edits are overwritten.
API_BEARER_TOKEN={{ certmate_api_token }}
SECRET_KEY={{ certmate_secret_key }}
{% if certmate_backup_passphrase %}
CERTMATE_BACKUP_PASSPHRASE={{ certmate_backup_passphrase }}
{% endif %}
{% if certmate_cloudflare_token %}
CLOUDFLARE_TOKEN={{ certmate_cloudflare_token }}
{% endif %}
{% if certmate_version %}
CERTMATE_VERSION={{ certmate_version }}
{% endif %}
CERTMATE_BIND={{ certmate_bind }}
CERTMATE_PORT={{ certmate_port }}
BEHIND_PROXY={{ certmate_behind_proxy | bool | lower }}
