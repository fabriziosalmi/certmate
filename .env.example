# CertMate Configuration
# Copy this file to .env and update the values.
#
# Every variable below is read by the application. If you find one here that
# nothing reads, that is a bug — see tests/test_env_example_is_honest.py, which
# fails the build for exactly that.

# Flask Configuration
# Refuses `--debug` when set to production (app.py).
FLASK_ENV=production

# Application Settings
# The port the app binds. There is no HOST variable: the bind address is not
# configurable here. Publish the container on 127.0.0.1:8000:8000 if you want
# it reachable on loopback only — setting HOST would have looked like a
# security control while the service listened on every interface (#429).
PORT=8000

# Cloudflare API Token
# Get this from: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone:DNS:Edit, Zone:Zone:Read
# This bootstraps the default Cloudflare account on first run. Every other DNS
# provider — Route53, Azure, Google, PowerDNS and the rest — is configured in
# the web UI or via the API, not through environment variables.
CLOUDFLARE_TOKEN=your_cloudflare_api_token_here

# API Authentication
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Alternatively, set API_BEARER_TOKEN_FILE to a path containing the token.
API_BEARER_TOKEN=your_secure_api_token_here

# Flask session signing key
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Alternatively, set SECRET_KEY_FILE to a path containing the key.
SECRET_KEY=your_secret_key_here

# Optional: logging
# CERTMATE_LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR
# CERTMATE_LOG_JSON=true           # structured JSON on stdout
# CERTMATE_LOG_FILE=/app/logs/certmate.log   # opt-in file the UI log stream reads
